# Newsroom configuration. Copy to .env and edit; every value has a working default
# except ANTHROPIC_API_KEY, which is only needed for metered routing profiles.
#
# .env is gitignored -- never commit real keys.

# --- Local inference (free runs) ---
# OpenAI-compatible endpoint, e.g. llama-swap. Stages routed "local" go here.
NEWSROOM_LOCAL_BASE_URL=http://127.0.0.1:8001/v1

# --- Metered runs (optional) ---
# Only required if a routing profile sends stages to the Anthropic API.
# ANTHROPIC_API_KEY=
NEWSROOM_MODEL=claude-haiku-4-5-20251001

# --- Web server ---
# Command the Refresh button runs. Unset = refresh disabled in the UI.
NEWSROOM_REFRESH_COMMAND=.venv/bin/python claude_pipeline_runner.py --routing routing.json
# Abandon a run after this many seconds (default 3600).
NEWSROOM_REFRESH_TIMEOUT=3600

# --- remote_refresh.py (only if the pipeline runs on another machine) ---
NEWSROOM_REMOTE=newsroom-host
NEWSROOM_REMOTE_DIR=~/newsroom
