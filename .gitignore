__pycache__/
*.pyc
.venv/
raw_headlines_*.json
news_digest_*.txt
news_digest_*.csv
current.csv
news_digest_latest.csv
outlets_config.json
usage_*.json
*.tmp
# Benchmark inputs/outputs: the corpus is ~1MB of captured Claude responses, and the
# bench results are per-machine measurements, not source. routing.json IS committed --
# it is the decision those measurements produced.
calls_corpus.jsonl
calls_*.jsonl
bench_local*.json
v4flash_entail_negatives.json
routed_run.log
# Transfer artifact from the bundle-based deploy route, not project content.
*.bundle

# Local secrets and config -- .env.example is the tracked template.
.env
extension/newsroom-digest-source.zip
extension/SOURCES.sha256
nodejs_bin-*.whl

# The live settings password. Read by server.py at startup; must never be committed.
config_password.txt

# Per-run pipeline logs written by server.py run_refresh(). One per refresh, and they
# carry the output-contract report -- useful locally, noise in history.
pipeline_run_*.log

# Visitor access log written by server.py: contains IPs and user-agents (personal
# data), and is per-machine runtime output, not source.
access.log
access.log.*

# One-off model-comparison probes and their results. These measure one machine's
# hardware against a corpus that is itself gitignored, so they are not reproducible
# from a clean clone and do not belong in history. What they produced -- the routing
# decision and the numbers behind it -- is recorded in routing.json's "why" fields.
entail_probe_model.py
entail_prompt_variants.py
entail_probe_*.json
entail_variants_*.json
ensemble_probe.json
merge_probe_model.py
merge_probe*.json

# Superseded config backups and scratch output. Kept out of history because git
# already holds every prior routing.json; a stale .bak beside the live file is how
# the wrong one gets edited.
*.bak_*
*-bak
*.predeploy-*
_attic/

# Local call capture written when NEWSROOM_RECORD_LOCAL is set (see local_host.py).
# Runtime measurement data, grows with every run, and carries article text. Kept
# OUT of calls_corpus.jsonl on purpose: that corpus is ground truth because every
# "reference" in it is Claude's answer, and these rows are the local model's own.
local_calls.jsonl
local_calls*.jsonl
